{
  "name": "shop-flow",
  "version": "1.0.0",
  "description": "End-to-end test automation framework for SauceDemo built with Playwright",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:visual:update-linux": "node scripts/update-linux-snapshots.js",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "allure": "3.22.1",
    "allure-playwright": "3.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "private": true,
  "overrides": {
    "dompurify": "3.4.17",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
